# Environment: local | development | production
DJANGO_ENV=local
DJANGO_SECRET_KEY=change-me-in-production-use-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Production auto-config (AUTO_DEPLOY_CONFIG=1 in docker-compose.prod.yml)
# Detects server IP/hostname and sets ALLOWED_HOSTS, CORS, CSRF, PUBLIC_API_BASE.
SITE_DOMAIN=digigadg.com
# Optional extra hosts/origins:
# EXTRA_ALLOWED_HOSTS=api.digigadg.com
# EXTRA_CORS_ORIGINS=https://api.digigadg.com
# AUTO_DEPLOY_CONFIG=1
# TLS_ENABLED=false

# Cloudflare origin cert (optional) — place files in deploy/ssl/ (see deploy/ssl/README.md)
# CLOUDFLARE_ORIGIN_CERT=/etc/ssl/cloudflare/origin.pem
# CLOUDFLARE_ORIGIN_KEY=/etc/ssl/cloudflare/origin.key

# Database
POSTGRES_DB=gadgetstore
POSTGRES_USER=gadget
POSTGRES_PASSWORD=gadget_secret
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Daily 09:00 Asia/Tehran order report (set these only in the production .env)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Public URLs (dev defaults — production auto-deploy ignores localhost and uses SITE_DOMAIN)
PUBLIC_API_BASE=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth / JWT
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Payment
APP_DEEP_LINK_SCHEME=gadgetstore
TLS_ENABLED=false
CURRENCY=IRR

# Email (optional — SMTP can also be set in admin Settings → Email)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@gadgetstore.local

